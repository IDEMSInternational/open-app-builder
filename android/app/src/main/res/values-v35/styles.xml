<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      As values/styles.xml, with a navigation bar colour. From Android 15 the app is drawn behind the
      navigation bar, so the colour is not shown, but a theme without one gets dark navigation bar icons
      forced whenever the window background is light, so the app cannot set them (SystemBarsService)
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
